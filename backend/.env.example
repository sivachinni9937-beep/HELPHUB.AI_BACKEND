# Supabase Configuration
SUPABASE_URL=https://zoligkfqauqwaupiuviz.supabase.co
SUPABASE_ANON_KEY=your-supabase-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-secret-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# AI Provider: 'ollama' or 'gemini'
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
GEMMA_MODEL=gemma4:latest
AI_TIMEOUT_SECONDS=120
AI_MAX_INPUT_CHARS=5000
AI_RATE_LIMIT_PER_MINUTE=30

# Cloud AI Backup API
GEMINI_API_KEY=your-gemini-or-gemma-api-key
GEMINI_MODEL=models/gemini-3.5-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# CORS & Server Settings (Live URL: https://helphub-ai-backend-1.onrender.com)
FRONTEND_ORIGINS=*
ENVIRONMENT=production
LOG_LEVEL=INFO
DEMO_MODE=false
